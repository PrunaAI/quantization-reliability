# Copy this file to .env and fill in your values.

# HuggingFace
HF_HOME=/path/to/your/hf/cache
HUGGINGFACE_TOKEN=hf_your_token_here

# Weights & Biases
WANDB_API_KEY=your_wandb_key_here
WANDB_ENTITY=your_wandb_entity
WANDB_PROJECT=quantization-reliability

# Filesystem paths (all optional, see src/config.py for defaults)
QR_DATA_DIR=/path/to/dataset/cache
QR_MODEL_SAVE_DIR=/path/to/model/save/dir
QR_MODEL_CACHE_ROOT=/path/to/model/cache/root
QR_CACHE_ROOT=/path/to/.cache
QR_HF_CACHE_ROOT=/path/to/.cache/huggingface/hub
QR_RESULTS_DIR=/path/to/results
